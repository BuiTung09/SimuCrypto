generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String              @unique
  passwordHash      String?             @map("password_hash")
  username          String              @unique
  displayName       String?             @map("display_name")
  avatarUrl         String?             @map("avatar_url")
  googleId          String?             @unique @map("google_id")
  isActive          Boolean             @default(true) @map("is_active")
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  role              Int                 @default(0)
  proExpiryDate     DateTime?           @map("pro_expiry_date") @db.Timestamptz(6)
  proPausedAt       DateTime?           @map("pro_paused_at") @db.Timestamptz(6)
  proPauseUsed      Boolean             @default(false) @map("pro_pause_used")
  proPausedDaysRemaining Int?           @map("pro_paused_days_remaining")
  communityComments CommunityComment[]
  followers         CommunityFollow[]   @relation("Follower")
  following         CommunityFollow[]   @relation("Following")
  postLikes         CommunityPostLike[]
  communityPosts    CommunityPost[]
  portfolioAccount  PortfolioAccount?
  sessions          UserSession[]
  subscriptions     UserSubscription[]
  activities        UserActivity[]

  payments          PaymentHistory[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model MembershipPlan {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           BillingCycle       @unique
  name           String
  durationMonths Int                @map("duration_months")
  price          Decimal            @db.Decimal(12, 2)
  currency       String             @default("VND") @db.Char(3)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions  UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(active)
  startedAt   DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime           @map("ended_at") @db.Timestamptz(6)
  cancelledAt DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan        MembershipPlan     @relation(fields: [planId], references: [id])
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endedAt])
  @@map("user_subscriptions")
}

model PortfolioAccount {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  initialVirtualBalance Decimal            @default(10000) @map("initial_virtual_balance") @db.Decimal(20, 8)
  virtualBalance        Decimal            @default(10000) @map("virtual_balance") @db.Decimal(20, 8)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  balanceLedger         BalanceLedger[]
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings              PortfolioHolding[]
  trades                Trade[]

  @@map("portfolio_accounts")
}

model PortfolioHolding {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  pairSymbol  String           @map("pair_symbol") @db.VarChar(20)
  amount      Decimal          @default(0) @db.Decimal(30, 12)
  avgBuyPrice Decimal          @default(0) @map("avg_buy_price") @db.Decimal(30, 12)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account     PortfolioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, pairSymbol])
  @@index([accountId])
  @@index([pairSymbol])
  @@map("portfolio_holdings")
}

model Trade {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  pairSymbol    String           @map("pair_symbol") @db.VarChar(20)
  side          TradeSide
  quantity      Decimal          @db.Decimal(30, 12)
  price         Decimal          @db.Decimal(30, 12)
  totalValue    Decimal          @map("total_value") @db.Decimal(30, 12)
  feeValue      Decimal          @default(0) @map("fee_value") @db.Decimal(30, 12)
  marketContext Json?            @map("market_context")
  executedAt    DateTime         @default(now()) @map("executed_at") @db.Timestamptz(6)
  ledgerEntries BalanceLedger[]
  account       PortfolioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, executedAt(sort: Desc)])
  @@index([pairSymbol])
  @@map("trades")
}

model BalanceLedger {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String                 @map("account_id") @db.Uuid
  tradeId       String?                @map("trade_id") @db.Uuid
  entryType     BalanceLedgerEntryType @map("entry_type")
  amountDelta   Decimal                @map("amount_delta") @db.Decimal(30, 12)
  balanceBefore Decimal                @map("balance_before") @db.Decimal(20, 8)
  balanceAfter  Decimal                @map("balance_after") @db.Decimal(20, 8)
  description   String?
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  account       PortfolioAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trade         Trade?                 @relation(fields: [tradeId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@index([tradeId])
  @@map("balance_ledger")
}

model LearningLesson {
  id              BigInt          @id @default(autoincrement())
  slug            String          @unique
  title           String
  description     String?
  level           ExperienceLevel @default(beginner)
  durationMinutes Int             @default(10) @map("duration_minutes")
  topicTags       String[]        @default([]) @map("topic_tags")
  sortOrder       Int             @default(0) @map("sort_order")
  isPublished     Boolean         @default(true) @map("is_published")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([level, sortOrder])
  @@map("learning_lessons")
}

model CommunityPost {
  id            BigInt              @id @default(autoincrement())
  userId        String              @map("user_id") @db.Uuid
  title         String
  content       String
  category      String              @default("Thao luan")
  imageUrl      String?             @map("image_url")
  likesCount    Int                 @default(0) @map("likes_count")
  commentsCount Int                 @default(0) @map("comments_count")
  pinned        Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  comments      CommunityComment[]
  likes         CommunityPostLike[]
  tags          CommunityPostTag[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityPostTag {
  postId BigInt        @map("post_id")
  tag    String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag])
  @@map("community_post_tags")
}

model CommunityComment {
  id        BigInt        @id @default(autoincrement())
  postId    BigInt        @map("post_id")
  userId    String        @map("user_id") @db.Uuid
  content   String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunityPostLike {
  userId String        @map("user_id") @db.Uuid
  postId BigInt        @map("post_id")
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("community_post_likes")
}

model CommunityFollow {
  followerId  String @map("follower_id") @db.Uuid
  followingId String @map("following_id") @db.Uuid
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("community_follows")
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum TradeSide {
  buy
  sell
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum BillingCycle {
  monthly
  semiannual
  annual
}

enum BalanceLedgerEntryType {
  trade_buy
  trade_sell
  manual_adjustment
}

model UserActivity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activities")
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model PaymentHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("VND") @db.Char(3)
  months    Int      @default(1)
  memo      String?
  method    String   @default("VietQR")
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("payment_history")
}
